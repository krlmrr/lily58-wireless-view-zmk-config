#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// Match QMK: TAPPING_TERM 250 + HOLD_ON_OTHER_KEY_PRESS (hold-preferred is the &mt default).
&mt {
    tapping-term-ms = <250>;
};

/ {
    behaviors {
        // Tap = shift (hold to shift), double-tap = caps word.
        // Mirrors QMK's DOUBLE_TAP_SHIFT_TURNS_ON_CAPS_WORD (global) feature.
        l_shift_or_caps_word: l_shift_or_caps_word {
            compatible = "zmk,behavior-tap-dance";
            label = "L Shift or Caps Word";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp LEFT_SHIFT>, <&caps_word>;
        };

        r_shift_or_caps_word: r_shift_or_caps_word {
            compatible = "zmk,behavior-tap-dance";
            label = "R Shift or Caps Word";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp RIGHT_SHIFT>, <&caps_word>;
        };
    };

    macros {
        arrow: arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GREATER_THAN>;
            label = "ARROW";
        };

        equals_arrow: equals_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GREATER_THAN>;
            label = "EQUALS_ARROW";
        };

        return: return {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp E &kp T &kp U &kp R &kp N>;
            label = "RETURN";
        };
    };

    // Windows/Linux shortcuts — active only on the Win (1) and Lin (2) layers.
    combos {
        compatible = "zmk,combos";

        combo_win_key {
            bindings = <&kp LEFT_WIN>;
            timeout-ms = <170>;
            key-positions = <53 54>;
            layers = <1 2>;
        };

        combo_quit {
            bindings = <&kp LA(F4)>;
            timeout-ms = <170>;
            key-positions = <53 13>;
            layers = <1 2>;
        };

        combo_lock {
            bindings = <&kp LG(L)>;
            key-positions = <53 13 24>;
            timeout-ms = <200>;
            layers = <1 2>;
        };

        combo_lock_right {
            bindings = <&kp LG(L)>;
            key-positions = <13 24 54>;
            timeout-ms = <200>;
            layers = <1 2>;
        };

        combo_ctrl_alt_delete {
            bindings = <&kp LA(LC(ESCAPE))>;
            key-positions = <53 50 24>;
            timeout-ms = <200>;
            layers = <1 2>;
        };

        combo_halt_alt {
            bindings = <&kp LA(LC(ESCAPE))>;
            key-positions = <50 54 24>;
            timeout-ms = <200>;
            layers = <1 2>;
        };

        combo_screen_shot {
            bindings = <&kp LG(LS(S))>;
            key-positions = <53 4 36>;
            timeout-ms = <170>;
            layers = <1 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0 — Base (macOS / QWERTY)
        Base {
            display-name = "Base";
            bindings = <
&kp GRAVE              &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                                       &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB                &kp Q   &kp W   &kp E   &kp R   &kp T                                        &kp Y   &kp U   &kp I      &kp O    &kp P     &kp BACKSLASH
&mt LCTRL ESCAPE       &kp A   &kp S   &kp D   &kp F   &kp G                                        &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&l_shift_or_caps_word  &kp Z   &kp X   &kp C   &kp V   &kp B   &kp ENTER          &kp BACKSPACE     &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &r_shift_or_caps_word
                                       &kp LALT  &sk LS(LC(LA(LGUI)))  &mo 5  &mt LEFT_COMMAND SPACE    &kp SPACE  &mo 4  &kp LC(LA(LGUI))  &kp RIGHT_ALT
            >;
        };

        // Layer 1 — Windows
        Win {
            display-name = "Win";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans            &trans  &trans  &trans  &trans  &trans  &trans
                        &kp LALT  &kp LGUI  &mo 5  &mt LCTRL SPACE    &mt RCTRL SPACE  &mo 4  &sk LS(LC(LA(LGUI)))  &kp RIGHT_ALT
            >;
        };

        // Layer 2 — Linux (identical to Windows)
        Lin {
            display-name = "Lin";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans            &trans  &trans  &trans  &trans  &trans  &trans
                        &kp LALT  &kp LGUI  &mo 5  &mt LCTRL SPACE    &mt RCTRL SPACE  &mo 4  &sk LS(LC(LA(LGUI)))  &kp RIGHT_ALT
            >;
        };

        // Layer 3 — Game (plain modifiers, no mod-taps, for responsiveness)
        Game {
            display-name = "Game";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                                    &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T                                     &kp Y   &kp U   &kp I      &kp O    &kp P     &kp BACKSLASH
&kp LCTRL  &kp A   &kp S   &kp D   &kp F   &kp G                                     &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V   &kp B   &kp ENTER          &kp BACKSPACE  &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                                   &kp LALT  &kp LGUI  &mo 5  &kp SPACE    &kp SPACE  &mo 4  &sk LS(LC(LA(LGUI)))  &kp RIGHT_ALT
            >;
        };

        // Layer 4 — Lower (symbols / arrows / media)
        Lower {
            display-name = "Lower";
            bindings = <
&none   &kp EXCLAMATION  &kp AT_SIGN    &kp HASH              &kp DOLLAR             &kp PERCENT                        &kp CARET       &kp AMPERSAND  &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE
&trans  &kp HASH         &kp AMPERSAND  &kp LEFT_BRACE        &kp RIGHT_BRACE        &none                              &none           &kp EQUAL      &none              &arrow                &equals_arrow          &none
&trans  &kp EXCLAMATION  &kp DOLLAR     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none                              &kp LEFT_ARROW  &kp DOWN       &kp UP_ARROW       &kp RIGHT             &none                  &none
&trans  &kp PERCENT      &kp CARET      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &return      &trans    &kp DELETE  &none           &kp K_MUTE     &kp C_VOLUME_DOWN  &kp C_VOLUME_UP       &none                  &trans
                                        &trans                &trans                 &trans       &trans    &trans      &trans          &trans         &trans
            >;
        };

        // Layer 5 — Raise (layer switching + Bluetooth / output management)
        Raise {
            display-name = "Raise";
            bindings = <
&none   &to 0         &to 1         &to 2         &to 3         &none                              &none       &none   &none   &none    &none    &out OUT_TOG
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                       &bt BT_CLR  &none   &none   &none    &none    &none
&trans  &none         &none         &none         &none         &none                              &none       &none   &none   &none    &none    &none
&trans  &none         &none         &none         &none         &none         &none    &kp DELETE  &none       &none   &none   &none    &none    &trans
                                    &trans        &trans        &trans        &trans   &trans      &trans      &trans  &trans
            >;
        };
    };
};
